; Z80-NEXT:    ld b, h
; Z80-NEXT:    ld c, l
; Z80-NEXT:    ld hl, 200
; Z80-NEXT:    add hl, sp
; Z80-NEXT:    ld sp, hl
; Z80-NEXT:    ld h, b
; Z80-NEXT:    ld l, c
