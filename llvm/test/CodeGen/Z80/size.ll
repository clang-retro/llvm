; I8080-NEXT:    ld b, h
; I8080-NEXT:    ld c, l
; I8080-NEXT:    ld hl, 65336
; I8080-NEXT:    add hl, sp
; I8080-NEXT:    ld sp, hl
; I8080-NEXT:    ld h, b
; I8080-NEXT:    ld l, c
; I8080-NEXT:    ld a, l
; I8080-NEXT:    ld hl, 150
; I8080-NEXT:    add hl, sp
; I8080-NEXT:    ld (hl), a
; I8080-NEXT:    ld hl, 0
; I8080-NEXT:    add hl, sp
; I8080-NEXT:    call use
; I8080-NEXT:    push hl
; I8080-NEXT:    ld hl, 152
; I8080-NEXT:    add hl, sp
; I8080-NEXT:    ld a, (hl)
; I8080-NEXT:    pop hl
; I8080-NEXT:    ld l, a
; I8080-NEXT:    ld b, h
; I8080-NEXT:    ld c, l
; I8080-NEXT:    ld hl, 200
; I8080-NEXT:    add hl, sp
; I8080-NEXT:    ld sp, hl
; I8080-NEXT:    ld h, b
