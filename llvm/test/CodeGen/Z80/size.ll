; Sign tests look at the sign bit alone.
define i16 @neg16(i16 %x) {
; Z80-LABEL: neg16:
; Z80:       ; %bb.0:
; Z80-NEXT:    ld e, l
; Z80-NEXT:    ld d, h
; Z80-NEXT:    ld hl, 5
; Z80-NEXT:    ld a, d
; Z80-NEXT:    or a
; Z80-NEXT:    jp m, .LBB0_2
; Z80-NEXT:  ; %bb.1:
; Z80-NEXT:    ld hl, 9
; Z80-NEXT:  .LBB0_2:
; Z80-NEXT:    ret
;
; I8080-LABEL: neg16:
; I8080:       ; %bb.0:
; I8080-NEXT:    ld e, l
; I8080-NEXT:    ld d, h
; I8080-NEXT:    ld hl, 5
; I8080-NEXT:    ld a, d
; I8080-NEXT:    or a
; I8080-NEXT:    jp m, .LBB0_2
; I8080-NEXT:  ; %bb.1:
; I8080-NEXT:    ld hl, 9
; I8080-NEXT:  .LBB0_2:
; I8080-NEXT:    ret
  %c = icmp slt i16 %x, 0
  %r = select i1 %c, i16 5, i16 9
  ret i16 %r
}

