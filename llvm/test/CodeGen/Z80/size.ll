; A byte compared with 0 uses OR A.
define i8 @zero8(i8 %x) {
; Z80-LABEL: zero8:
; Z80:       ; %bb.0:
; Z80-NEXT:    ld a, l
; Z80-NEXT:    ld l, 3
; Z80-NEXT:    or a
; Z80-NEXT:    jp z, .LBB3_2
; Z80-NEXT:  ; %bb.1:
; Z80-NEXT:    ld l, 4
; Z80-NEXT:  .LBB3_2:
; Z80-NEXT:    ret
;
; I8080-LABEL: zero8:
; I8080:       ; %bb.0:
; I8080-NEXT:    ld a, l
; I8080-NEXT:    ld l, 3
; I8080-NEXT:    or a
; I8080-NEXT:    jp z, .LBB3_2
; I8080-NEXT:  ; %bb.1:
; I8080-NEXT:    ld l, 4
; I8080-NEXT:  .LBB3_2:
; I8080-NEXT:    ret
  %c = icmp eq i8 %x, 0
  %r = select i1 %c, i8 3, i8 4
  ret i8 %r
}

; x >> 15 and x >> 7, arithmetic, are the sign mask.
define i16 @sra15(i16 %x) {
; Z80-LABEL: sra15:
; Z80:       ; %bb.0:
; Z80-NEXT:    ld a, h
; Z80-NEXT:    ld l, a
; Z80-NEXT:    rla
; Z80-NEXT:    sbc a, a
; Z80-NEXT:    ld h, a
; Z80-NEXT:    ld l, h
; Z80-NEXT:    ret
;
; I8080-LABEL: sra15:
; I8080:       ; %bb.0:
; I8080-NEXT:    ld a, h
; I8080-NEXT:    ld l, a
; I8080-NEXT:    rla
; I8080-NEXT:    sbc a, a
; I8080-NEXT:    ld h, a
; I8080-NEXT:    ld l, h
; I8080-NEXT:    ret
  %r = ashr i16 %x, 15
  ret i16 %r
}

